<?xml version="1.0"?>
<robot name="gyubot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- 1. 상수 정의 (Properties) -->
    <!-- 치수를 변수로 관리하면 나중에 로봇 크기를 바꿀 때 매우 편리함-->
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_length" value="0.5" />
    <xacro:property name="base_height" value="0.2" />

    <xacro:property name="wheel_radius" value="0.10" />
    <xacro:property name="wheel_width" value="0.05" />
    <xacro:property name="wheel_ygap" value="0.025" /> <!-- 본체와 바퀴 사이의 유격-->

    <!-- 바퀴 중심 위치(Offset) 계산 -->
    <xacro:property name="wheel_xoff" value="0.15" />
    <xacro:property name="wheel_yoff" value="${base_width/2 + wheel_width/2 + wheel_ygap}"/>
    <xacro:property name="wheel_zoff" value="0.05" />

    <!-- 2. Base Link 정의 -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.0 0.0 0.8 1.0"/>
            </material>
        </visual>
    </link>

    <!-- 3. 바퀴 매크로 (Wheel Macro) -->
    <!-- 매크로는 프로그래밍의 '함수'와 같다. 바퀴 4개를 일일이 코딩하지 않고 이 틀을 사용함-->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <!-- Cylinder는 기본적으로 위아래로 서 있다. rpy="${pi/2} 0 0"으로 90도 눕혀준다.-->
                 <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                 <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                 </geometry>
                 <material name="black">
                    <color rgba="0.0 0.0 0.0 1.0"/>
                 </material>
            </visual>
        </link>

        <!-- Joint: base_link와 바퀴를 연결 -->
        <joint name="${prefix}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <!-- x_reflect, y_reflect을 이용해 4군데 위치를 결정한다. -->
            <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff}" rpy="0 0 0" />
            <axis xyz="0 1 0 "/> <!-- 바퀴가 회전하는 축 (y축) -->
        </joint>
    </xacro:macro>

    <!-- 4. 매크로 호출 (4개의 바퀴 생성) -->
    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1" />
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1" />
    <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1" />
    <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1" />
</robot>
